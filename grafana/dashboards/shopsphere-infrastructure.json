{
  "uid": "shopsphere-infrastructure",
  "title": "ShopSphere / Infrastructure",
  "description": "Linux Docker host: Desktop reports shared VM/kernel CPU, memory, and block I/O. Capacity measures the Docker storage filesystem, not Windows or a container quota. NGINX stub_status has aggregate counts only.",
  "tags": [
    "shopsphere",
    "phase7"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Linux host CPU busy",
      "description": "CPU activity averaged over host cores.",
      "datasource": {
        "type": "prometheus",
        "uid": "shopsphere-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval]))",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "shopsphere-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Linux host memory used",
      "description": "Available memory accounts for reclaimable caches; this is the host, not the node-exporter container.",
      "datasource": {
        "type": "prometheus",
        "uid": "shopsphere-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "shopsphere-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Docker storage filesystem space used",
      "description": "Capacity of the filesystem containing Docker logs, read using stat via node exporter textfile support. Normally this is the Docker data disk; it does not cover all host filesystems or a container quota.",
      "datasource": {
        "type": "prometheus",
        "uid": "shopsphere-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - shopsphere_docker_storage_avail_bytes / shopsphere_docker_storage_size_bytes",
          "legendFormat": "Docker storage filesystem",
          "datasource": {
            "type": "prometheus",
            "uid": "shopsphere-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Disk bytes per second",
      "description": "Kernel block-device activity, not individual container I/O.",
      "datasource": {
        "type": "prometheus",
        "uid": "shopsphere-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_disk_read_bytes_total{device!~\"loop.*|ram.*\"}[$__rate_interval])",
          "legendFormat": "{{device}} read",
          "datasource": {
            "type": "prometheus",
            "uid": "shopsphere-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "rate(node_disk_written_bytes_total{device!~\"loop.*|ram.*\"}[$__rate_interval])",
          "legendFormat": "{{device}} written",
          "datasource": {
            "type": "prometheus",
            "uid": "shopsphere-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "NGINX requests per second",
      "description": "Includes proxy health and exporter stub_status traffic. Open-source stub_status does not expose latency or status-code breakdowns.",
      "datasource": {
        "type": "prometheus",
        "uid": "shopsphere-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(nginx_http_requests_total[$__rate_interval])",
          "legendFormat": "requests",
          "datasource": {
            "type": "prometheus",
            "uid": "shopsphere-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "NGINX connections",
      "description": "Current aggregate connection states.",
      "datasource": {
        "type": "prometheus",
        "uid": "shopsphere-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nginx_connections_active",
          "legendFormat": "active",
          "datasource": {
            "type": "prometheus",
            "uid": "shopsphere-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "nginx_connections_reading",
          "legendFormat": "reading",
          "datasource": {
            "type": "prometheus",
            "uid": "shopsphere-prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "nginx_connections_writing",
          "legendFormat": "writing",
          "datasource": {
            "type": "prometheus",
            "uid": "shopsphere-prometheus"
          }
        },
        {
          "refId": "D",
          "expr": "nginx_connections_waiting",
          "legendFormat": "waiting",
          "datasource": {
            "type": "prometheus",
            "uid": "shopsphere-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Collection health",
      "description": "Exporter reachability and backend collection health are separate signals.",
      "datasource": {
        "type": "prometheus",
        "uid": "shopsphere-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"linux-host|nginx|prometheus\"}",
          "legendFormat": "{{job}} scrape",
          "datasource": {
            "type": "prometheus",
            "uid": "shopsphere-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "nginx_up",
          "legendFormat": "NGINX status fetch",
          "datasource": {
            "type": "prometheus",
            "uid": "shopsphere-prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "node_scrape_collector_success",
          "legendFormat": "{{collector}} collector",
          "datasource": {
            "type": "prometheus",
            "uid": "shopsphere-prometheus"
          }
        },
        {
          "refId": "D",
          "expr": "shopsphere_docker_storage_collection_success",
          "legendFormat": "storage capacity collection",
          "datasource": {
            "type": "prometheus",
            "uid": "shopsphere-prometheus"
          }
        },
        {
          "refId": "E",
          "expr": "node_textfile_scrape_error",
          "legendFormat": "textfile error (0 is healthy)",
          "datasource": {
            "type": "prometheus",
            "uid": "shopsphere-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Storage capacity sample age",
      "description": "The textfile writer refreshes every five seconds. Increasing age means capacity values are stale even if the exporter answers.",
      "datasource": {
        "type": "prometheus",
        "uid": "shopsphere-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - node_textfile_mtime_seconds",
          "legendFormat": "{{file}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ]
}
