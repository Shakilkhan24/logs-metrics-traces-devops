# Optional Compose overrides. Copy to .env or export in your shell.
# Compose automatically reads .env for interpolation, not arbitrary injection.
SHOPSPHERE_PORT=8088
PAYMENT_TIMEOUT_SECONDS=2

# Native Python settings (Phases 2–4); export them explicitly for native runs.
# Python does not auto-load .env. Compose sets its own service-name URLs and
# does not use these two host URLs, even when they are present in .env.
PAYMENT_BASE_URL=http://127.0.0.1:8001
DATABASE_URL=postgresql+psycopg://shopsphere:shopsphere_local@127.0.0.1:5432/shopsphere
