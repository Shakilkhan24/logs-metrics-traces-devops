# Optional Compose overrides. Copy to .env or export in your shell.
# Compose automatically reads .env for interpolation, not arbitrary injection.
SHOPSPHERE_PORT=8088
PAYMENT_TIMEOUT_SECONDS=2
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
# Initial local Grafana login; changing these does not reset an existing account.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=shopsphere_local
# Run bash elastic/prepare-docker-logs.sh once before first startup.
DOCKER_LOG_VOLUME=shopsphere_docker_logs
# Optional helper overrides. DOCKER_LOG_ROOT is inside the Docker daemon host.
# DOCKER_LOG_ROOT=/var/lib/docker/containers
# DOCKER_WINDOWS_CLI=/mnt/c/Program Files/Docker/Docker/resources/bin/docker.exe

# Native Python settings (Phases 2–4); export them explicitly for native runs.
# Python does not auto-load .env. Compose sets its own service-name URLs and
# does not use these two host URLs, even when they are present in .env.
PAYMENT_BASE_URL=http://127.0.0.1:8001
DATABASE_URL=postgresql+psycopg://shopsphere:shopsphere_local@127.0.0.1:5432/shopsphere
